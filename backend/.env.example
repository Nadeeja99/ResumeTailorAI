GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001

# ── AI (optional — defaults shown) ─────────────────────────────────────────────
# Tried in order; later models are used when earlier ones are unavailable/overloaded
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# EMBEDDING_MODEL=gemini-embedding-2
# LLM_TIMEOUT_MS=90000
# MINIMAL | LOW | MEDIUM | HIGH — unset uses each model's default
# LLM_THINKING_LEVEL=
# Include raw prompts in API telemetry (defaults to true outside production)
# EXPOSE_PROMPTS=true

# ── Server (optional) ──────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# LOG_LEVEL=info
# Proxy hops to trust for client IPs (set to 1 behind nginx)
# TRUST_PROXY=0
# DATABASE_PATH=../data/app.db

# Stripe – required for freemium billing
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# Create a recurring price in Stripe Dashboard and paste its ID here (e.g. price_xxx)
STRIPE_PRO_PRICE_ID=your_stripe_price_id_here
# Run `stripe listen --forward-to localhost:3001/api/billing/webhook` to get this
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
